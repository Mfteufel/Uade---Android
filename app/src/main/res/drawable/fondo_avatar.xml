<?xml version="1.0" encoding="utf-8"?>
<!--
    Círculo de fondo del avatar del perfil.

    Se ve cuando el usuario todavía no cargó foto de perfil: muestra sus
    iniciales sobre este círculo (ver view_avatar.xml).

    El color sale del tema (?attr/colorPrimaryContainer) y no de colors.xml
    directamente, para que acompañe el modo claro y el oscuro sin duplicar nada.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorPrimaryContainer" />
</shape>