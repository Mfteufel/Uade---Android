<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del adaptive icon (Android 8+): degradé diagonal naranja -> azul,
    los mismos dos colores del isotipo (arcos entrelazados) que define
    ic_launcher_foreground.png, para que ambas capas se lean como una sola
    marca al superponerse.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF9800" android:offset="0.0" />
                <item android:color="#00579B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
