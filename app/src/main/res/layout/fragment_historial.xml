<?xml version="1.0" encoding="utf-8"?>
<!--
    Historial de operaciones — Punto 9 del TPO.

    De arriba hacia abajo:
      1. Toolbar con flecha para volver al perfil.
      2. Pendientes de entrega: ventas aceptadas que el comprador todavía no
         confirmó que recibió. No son parte del historial y los filtros no las
         afectan; el bloque se oculta si no hay ninguna.
      3. Historial: filtros de tipo (Todas / Compras / Ventas, selección única)
         y de rango de fechas (chip que abre el calendario; la cruz lo borra).
      4. La lista de operaciones concretadas, con sus estados de carga, vacío y
         error superpuestos (el Fragment muestra uno solo por vez, igual que el
         resto de la app).
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.historial.HistorialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_flecha_atras"
            app:title="@string/historial_titulo" />

        <!-- ============ Pendientes de entrega ============ -->
        <LinearLayout
            android:id="@+id/bloquePendientesEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/espaciado_pantalla"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historial_titulo_pendientes"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPendientesEntrega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_operacion" />
        </LinearLayout>

        <!-- ============ Historial: filtros ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_mediano"
            android:paddingHorizontal="@dimen/espaciado_pantalla"
            android:text="@string/historial_titulo_concretadas"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/espaciado_pantalla"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Los chips de tipo se agregan desde el Fragment con ChipsUtils. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoTipoOperacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFechas"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaciado_chico"
                    android:text="@string/historial_fechas"
                    app:chipIcon="@drawable/ic_filtros"
                    app:closeIconVisible="false" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============ Lista y estados ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaOperaciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/espaciado_pantalla"
                android:paddingBottom="@dimen/lista_padding_inferior"
                tools:itemCount="3"
                tools:listitem="@layout/item_operacion" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/estadoVacioHistorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_buscar" />

                <TextView
                    android:id="@+id/textoVacioHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Todavía no concretaste operaciones" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/estadoErrorHistorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_error" />

                <TextView
                    android:id="@+id/textoErrorHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="No pudimos cargar tu historial" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonReintentarHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:text="@string/error_reintentar" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
