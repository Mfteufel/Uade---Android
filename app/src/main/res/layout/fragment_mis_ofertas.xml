<?xml version="1.0" encoding="utf-8"?>
<!--
    "Mis ofertas" (Punto 7): toolbar + TabLayout (Enviadas/Recibidas) + un solo
    RecyclerView que se recarga al cambiar de tab. Progreso/estado vacío
    superpuestos en un FrameLayout.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.misofertas.MisOfertasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_atras"
            app:title="@string/mis_ofertas_titulo"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabsMisOfertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_ofertas_tab_enviadas" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mis_ofertas_tab_recibidas" />

        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaMisOfertas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/espaciado_chico"
                android:paddingBottom="@dimen/lista_padding_inferior"
                tools:itemCount="2"
                tools:listitem="@layout/item_oferta" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoMisOfertas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/estadoVacioMisOfertas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ofertar" />

                <TextView
                    android:id="@+id/textoVacioMisOfertas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:gravity="center"
                    android:text="@string/mis_ofertas_vacio_enviadas"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
