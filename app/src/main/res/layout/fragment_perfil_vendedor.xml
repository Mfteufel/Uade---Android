<?xml version="1.0" encoding="utf-8"?>
<!--
    Perfil público del vendedor (Punto 4).

    De arriba hacia abajo:
      1. Toolbar con flecha para volver.
      2. Contenido: ficha del vendedor (avatar, reputación, antigüedad) fija
         arriba + listado de sus publicaciones activas.
      3. El spinner de carga y el estado de error se superponen al contenido y el
         Fragment muestra uno solo por vez, igual que en el Home y el Detalle.

    La ficha del vendedor queda FUERA de un scroll y el RecyclerView tiene el
    suyo propio: meter un RecyclerView adentro de un NestedScrollView lo obliga a
    medir todos sus ítems y anula el reciclado.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedorPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".ui.perfil.PerfilVendedorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ 1. Encabezado ============ -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/ic_flecha_atras"
            app:title="@string/perfil_titulo" />

        <!-- ============ 2. Contenido ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/contenidoPerfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Ficha del vendedor -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/espaciado_pantalla">

                    <TextView
                        android:id="@+id/inicialesPerfil"
                        android:layout_width="@dimen/avatar_perfil_tamano"
                        android:layout_height="@dimen/avatar_perfil_tamano"
                        android:background="@drawable/bg_avatar_vendedor"
                        android:contentDescription="@string/vendedor_avatar_descripcion"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="MG" />

                    <TextView
                        android:id="@+id/nombrePerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_pantalla"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/inicialesPerfil"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Martina G." />

                    <TextView
                        android:id="@+id/reputacionPerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_pantalla"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        app:drawableStartCompat="@drawable/ic_estrella"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/inicialesPerfil"
                        app:layout_constraintTop_toBottomOf="@id/nombrePerfil"
                        tools:text="4,8 · 23 ventas" />

                    <TextView
                        android:id="@+id/miembroDesdePerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_pantalla"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/inicialesPerfil"
                        app:layout_constraintTop_toBottomOf="@id/reputacionPerfil"
                        tools:text="En Ronda desde julio de 2024" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/espaciado_pantalla" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/espaciado_pantalla"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:text="@string/perfil_publicaciones_titulo"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/cantidadPublicacionesPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/espaciado_pantalla"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="3 publicaciones activas" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaPublicacionesVendedor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="@dimen/espaciado_chico"
                        android:paddingBottom="@dimen/lista_padding_inferior"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_publicacion" />

                    <!-- Vendedor sin publicaciones activas -->
                    <LinearLayout
                        android:id="@+id/estadoVacioPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:alpha="0.4"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_persona" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espaciado_pantalla"
                            android:gravity="center"
                            android:text="@string/perfil_sin_publicaciones"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Spinner de la carga inicial -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progresoInicial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Estado de error: el perfil no se pudo cargar -->
            <LinearLayout
                android:id="@+id/estadoError"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_error" />

                <TextView
                    android:id="@+id/textoError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="No pudimos cargar el perfil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonReintentar"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_pantalla"
                    android:text="@string/error_reintentar" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
