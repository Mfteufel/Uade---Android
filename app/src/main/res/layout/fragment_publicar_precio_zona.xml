<?xml version="1.0" encoding="utf-8"?>
<!-- Paso 4 del wizard de publicar (Punto 5): precio y zona de entrega. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".ui.publicar.PublicarPrecioZonaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_pantalla">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publicar_paso_precio_zona"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputPrecio"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_pantalla"
            android:hint="@string/publicar_precio_hint"
            app:prefixText="$">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            ExposedDropdownMenu: Zona tiene 16 valores, demasiados para chips
            (a diferencia de Categoria, que sí se resuelve con chips en el Home
            porque son solo 8). Con un dropdown el usuario elige uno de una lista,
            que es justamente la semántica de este campo.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputZona"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_mediano"
            android:hint="@string/publicar_zona_hint">

            <AutoCompleteTextView
                android:id="@+id/campoZona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textoErrorZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/publicar_error_zona"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_pantalla"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonAtras"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/publicar_atras" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonSiguiente"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_mediano"
                android:layout_weight="1"
                android:text="@string/publicar_siguiente" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
