<?xml version="1.0" encoding="utf-8"?>
<!--
    Ítem de una búsqueda guardada dentro de BusquedasGuardadasBottomSheet.
    Tocar la card aplica la búsqueda; el tacho la elimina.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/espaciado_pantalla"
    android:layout_marginVertical="@dimen/espaciado_chico"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espaciado_mediano">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- El nombre se arma con todos los filtros aplicados y puede ser largo, así que sigue en más renglones en vez de cortarse. -->
            <TextView
                android:id="@+id/nombreBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="notebook · Tecnología · Nuevo, Como nuevo · $100.000–$500.000 · Solo mi zona" />

            <TextView
                android:id="@+id/indicadorNovedadBusqueda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/busqueda_guardada_novedad"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/botonEliminarBusqueda"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/espaciado_chico"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/busqueda_guardada_eliminar"
            android:padding="8dp"
            android:src="@drawable/ic_eliminar" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
