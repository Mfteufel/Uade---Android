<?xml version="1.0" encoding="utf-8"?>
<!--
    Encabezado chico de subsección ("Tus preguntas", "Tu oferta"), para cuando
    hace falta insertar un título dentro de un contenedor armado en runtime
    (grupoMisInteracciones) y no tiene sentido crear un layout entero para eso.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textoEncabezadoSeccion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaciado_mediano"
    android:textAppearance="?attr/textAppearanceTitleSmall"
    tools:text="Tus preguntas" />
