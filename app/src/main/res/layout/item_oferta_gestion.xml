<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de una oferta recibida, en la hoja "Gestionar publicación" (Punto 8).

    Es casi igual a item_interaccion.xml (mismos ids de icono/texto/autor para
    poder reusar FormatoUtils igual que antes), pero le suma una fila de acción
    abajo: mientras la oferta no está aceptada muestra el botón "Aceptar";
    apenas se acepta, el botón se cambia por un texto fijo, porque el Punto 8
    no contempla "desaceptar" una oferta (eso ya sería parte del Punto 7, que
    todavía no existe).

    No tiene id en la raíz por el mismo motivo que item_interaccion.xml: se
    infla una fila por oferta y no se busca por id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaciado_chico"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconoInteraccion"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ofertar"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_chico"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Monto formateado, ej. "$ 480.000" -->
            <TextView
                android:id="@+id/textoInteraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="$ 400.000" />

            <!-- "Nicolás P. · hace 2 h" -->
            <TextView
                android:id="@+id/autorInteraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Nicolás P. · hace 2 h" />
        </LinearLayout>
    </LinearLayout>

    <!-- Área de acción: solo una de las dos vistas está visible por vez. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAceptarOferta"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingVertical="4dp"
            android:text="@string/gestion_aceptar_oferta"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textoOfertaAceptada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gestion_oferta_aceptada"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
