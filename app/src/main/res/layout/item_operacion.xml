<?xml version="1.0" encoding="utf-8"?>
<!--
    Una operación del historial (Punto 9): fecha, artículo, monto final y
    contraparte, que son los cuatro datos que pide el enunciado, más el estado
    de la entrega y de la calificación.

    Si la entrega todavía no se confirmó, abajo va "Confirmar entrega" (solo el
    comprador) o el aviso de que falta. Si ya se confirmó, la zona de
    calificación muestra una sola de tres cosas (la decide el servidor, ver
    Operacion.puedeCalificar()):
      - botón "Calificar" + hasta cuándo se puede;
      - las estrellas que ya se dejaron;
      - que el plazo de 7 días venció.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaciado_chico"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_pantalla">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textoArticuloOperacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Teclado mecánico Redragon" />

            <TextView
                android:id="@+id/textoMontoOperacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_chico"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                tools:text="$ 45.000" />
        </LinearLayout>

        <!-- Tocar la contraparte abre su perfil público. -->
        <TextView
            android:id="@+id/textoContraparteOperacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="Le compraste a Sofía M." />

        <TextView
            android:id="@+id/textoFechaOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Entregada el 16 de septiembre de 2026" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_mediano" />

        <!-- Entrega sin confirmar: el comprador la confirma, el vendedor espera. -->
        <LinearLayout
            android:id="@+id/contenedorPendienteEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/textoPendienteEntrega"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="@string/historial_ya_recibiste" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonConfirmarEntrega"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_chico"
                android:text="@string/historial_confirmar_entrega" />
        </LinearLayout>

        <!-- Calificación: una sola de las tres variantes está visible. -->
        <LinearLayout
            android:id="@+id/contenedorCalificable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textoPlazoCalificacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Podés calificar hasta el 23/09/2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCalificar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_chico"
                android:text="@string/historial_calificar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorCalificado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_ya_calificaste"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <RatingBar
                android:id="@+id/barraMiCalificacion"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_chico"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="1"
                tools:rating="4" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoPlazoVencido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:text="@string/historial_plazo_vencido"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
