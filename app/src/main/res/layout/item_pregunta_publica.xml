<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de una pregunta pública del Detalle: la pregunta (mismo formato que
    item_interaccion.xml, icono + texto + autor) y, si el vendedor ya la
    contestó, una segunda fila indentada debajo con la respuesta — alineada
    con el texto de la pregunta, no con su ícono, para que se note que es una
    respuesta a lo de arriba y no otra pregunta más.

    No tiene id en la raíz: se infla una vez por fila y no se busca por id, se
    guardan referencias a sus hijos en el momento de inflar (ver
    DetalleFragment#inflarFilaPregunta).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espaciado_chico"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_preguntar"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_chico"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoInteraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="¿Todavía tenés la caja original?"
                tools:ignore="HardcodedText,SpUsage" />

            <TextView
                android:id="@+id/autorInteraccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Nicolás P. · hace 2 h" />
        </LinearLayout>

    </LinearLayout>

    <!-- Indentada para alinear con el texto de la pregunta (20dp del ícono + espaciado_chico). -->
    <LinearLayout
        android:id="@+id/filaRespuestaPregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textoRespuestaPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Sí, todavía está disponible"
            tools:ignore="HardcodedText,SpUsage" />

        <TextView
            android:id="@+id/autorRespuestaPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Vendedor · hace 1 h" />

    </LinearLayout>

</LinearLayout>
