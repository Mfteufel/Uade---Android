<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de una publicación en el listado del Home.

    Muestra los datos que pide el Punto 3: título, precio, estado del artículo y
    zona del vendedor, más la foto (opcional según el enunciado) y la antigüedad
    de la publicación.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/espaciado_pantalla"
    android:layout_marginVertical="@dimen/espaciado_chico"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espaciado_mediano">

        <!-- Miniatura del artículo. Por ahora es un placeholder: ver ic_imagen. -->
        <ImageView
            android:id="@+id/fotoPublicacion"
            android:layout_width="@dimen/item_foto_ancho"
            android:layout_height="@dimen/item_foto_alto"
            android:background="@drawable/bg_foto_publicacion"
            android:contentDescription="@string/item_foto_descripcion"
            android:scaleType="center"
            android:src="@drawable/ic_imagen"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Punto 10 (indicador de novedad): visible solo si esta publicación matchea la búsqueda guardada. -->
        <TextView
            android:id="@+id/indicadorNuevaBusqueda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_novedad"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/item_nueva_busqueda"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/fotoPublicacion"
            app:layout_constraintTop_toTopOf="@id/fotoPublicacion"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tituloPublicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_mediano"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/botonFavorito"
            app:layout_constraintStart_toEndOf="@id/fotoPublicacion"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Notebook Lenovo IdeaPad 15" />

        <!--
            Punto 10 (Favoritos): toggle de favorito de la publicación.
        -->
        <ImageButton
            android:id="@+id/botonFavorito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorito_borde"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/precioPublicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_mediano"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fotoPublicacion"
            app:layout_constraintTop_toBottomOf="@id/tituloPublicacion"
            tools:text="$ 480.000" />

        <!-- Punto 10 (indicador de novedad): solo visible si el favorito bajó de precio. -->
        <TextView
            android:id="@+id/indicadorNovedadPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_mediano"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip_novedad"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/item_novedad_bajo_precio"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/fotoPublicacion"
            app:layout_constraintTop_toBottomOf="@id/precioPublicacion"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/estadoPublicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_mediano"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:background="@drawable/bg_estado_articulo"
            android:paddingHorizontal="@dimen/espaciado_chico"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:layout_constraintStart_toEndOf="@id/fotoPublicacion"
            app:layout_constraintTop_toBottomOf="@id/indicadorNovedadPrecio"
            tools:text="Usado" />

        <!-- Badge del estado de la PUBLICACIÓN (pausada/vendida), no del artículo:
             solo lo ve el dueño (el mock oculta las no activas para el resto), y
             solo cuando no está "Activa". Enganchado a estadoPublicacion para no
             tocar sus constraints existentes. -->
        <TextView
            android:id="@+id/estadoPublicacionItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_chico"
            android:background="@drawable/bg_estado_publicacion"
            android:paddingHorizontal="@dimen/espaciado_chico"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/estadoPublicacion"
            app:layout_constraintTop_toTopOf="@id/estadoPublicacion"
            tools:text="Pausada"
            tools:visibility="visible" />

        <!--
            Zona y antigüedad en un solo renglón ("Caballito · hace 5 h").
            El ícono va como drawableStart para no sumar otra View al árbol.
        -->
        <TextView
            android:id="@+id/zonaPublicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_mediano"
            android:layout_marginTop="@dimen/espaciado_chico"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:drawableStartCompat="@drawable/ic_zona"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/fotoPublicacion"
            app:layout_constraintTop_toBottomOf="@id/estadoPublicacion"
            tools:text="Caballito · hace 5 h" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
