<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">
    <!-- app:startDestination="@id/perfilFragment"> -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tpo.ui.home.HomeFragment"
        android:label="@string/home_titulo"
        tools:layout="@layout/fragment_home">

        <!--
            TODO (Punto 4 - Detalle de publicación): cuando exista DetailFragment,
            descomentar esta action y el destino de abajo, y reemplazar el Snackbar
            de HomeFragment.alAbrirPublicacion() por:

            Bundle args = new Bundle();
            args.putString("publicacionId", publicacion.getId());
            navController.navigate(R.id.action_home_to_detalle, args);

        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detalleFragment" />
        -->

        <!-- Punto 5: FAB del Home abre el wizard de publicar. -->
        <action
            android:id="@+id/action_home_to_publicar"
            app:destination="@id/nav_graph_publicar" />

        <!-- Punto 5: item del menú de la toolbar. -->
        <action
            android:id="@+id/action_home_to_misPublicaciones"
            app:destination="@id/misPublicacionesFragment" />

    </fragment>

    <!--
    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.tpo.ui.detalle.DetalleFragment"
        android:label="@string/detalle_titulo">
        <argument
            android:name="publicacionId"
            app:argType="string" />
    </fragment>
    -->

    <!-- Favoritos: destino de la bottom nav, ver menu_navegacion.xml. -->
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.tpo.ui.favoritos.FavoritosFragment"
        android:label="@string/favoritos_titulo"
        tools:layout="@layout/fragment_favoritos" />

    <!-- Punto 2 - Perfil y Reputación -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.tpo.ui.perfil.PerfilFragment"
        android:label="@string/perfil_titulo"
        tools:layout="@layout/fragment_perfil" />

    <!-- Punto 1 - Login. Primera pantalla de la app. -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tpo.login.LoginFragment"
        tools:layout="@layout/fragment_login">

        <!-- popUpTo + inclusive: al entrar al Home el login sale del historial,
             así el botón "atrás" cierra la app en vez de volver al login. -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <!-- Punto 5: wizard de publicación, ver nav_graph_publicar.xml. -->
    <include app:graph="@navigation/nav_graph_publicar" />

    <fragment
        android:id="@+id/misPublicacionesFragment"
        android:name="com.example.tpo.ui.mispublicaciones.MisPublicacionesFragment"
        android:label="@string/mis_publicaciones_titulo"
        tools:layout="@layout/fragment_mis_publicaciones" />

</navigation>
