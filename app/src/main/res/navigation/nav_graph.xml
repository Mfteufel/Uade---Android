<?xml version="1.0" encoding="utf-8"?>
<!--
    Grafo de navegación de Ronda.

    Por ahora tiene un solo destino: el Home. A medida que se implementen los
    otros puntos del TPO se van agregando acá como <fragment>, junto con las
    <action> que los conectan.

    Cuando esté el Punto 1 (Autenticación), el startDestination pasa a ser el
    login y de ahí al Home se navega con popUpTo + inclusive="true", para que el
    botón "atrás" en el Home cierre la app en vez de volver al login.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tpo.ui.home.HomeFragment"
        android:label="@string/home_titulo"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detalleFragment" />

    </fragment>

    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.tpo.ui.detalle.DetalleFragment"
        android:label="@string/detalle_titulo"
        tools:layout="@layout/fragment_detalle">
        <argument
            android:name="publicacionId"
            app:argType="string" />

        <action
            android:id="@+id/action_detalle_to_perfil"
            app:destination="@id/perfilVendedorFragment" />
    </fragment>

    <!--
        Perfil público del vendedor. Detalle y Perfil se pueden encadenar (ver un
        perfil, entrar a otra publicación suya, ver ese perfil...), así que la
        pila puede crecer. Se deja crecer a propósito: el "atrás" devuelve al
        usuario exactamente por donde vino, que es lo que espera. NO poner
        popUpTo para "cortar el ciclo": eso saca de la pila una pantalla que el
        usuario sí vio y el "atrás" termina saltando a otro lado.
    -->
    <fragment
        android:id="@+id/perfilVendedorFragment"
        android:name="com.example.tpo.ui.perfil.PerfilVendedorFragment"
        android:label="@string/perfil_titulo"
        tools:layout="@layout/fragment_perfil_vendedor">
        <argument
            android:name="vendedorId"
            app:argType="string" />

        <action
            android:id="@+id/action_perfil_to_detalle"
            app:destination="@id/detalleFragment" />
    </fragment>

</navigation>
