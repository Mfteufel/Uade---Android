<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">
    <!-- app:startDestination="@id/perfilFragment"> -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tpo.ui.home.HomeFragment"
        android:label="@string/home_titulo"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_detalle"
            app:destination="@id/detalleFragment" />

        <!-- Punto 5: FAB del Home abre el wizard de publicar. -->
        <action
            android:id="@+id/action_home_to_publicar"
            app:destination="@id/nav_graph_publicar" />

        <!-- Punto 5: item del menú de la toolbar. -->
        <action
            android:id="@+id/action_home_to_misPublicaciones"
            app:destination="@id/misPublicacionesFragment" />

        <!-- Punto 7: item "Mis ofertas" del menú de la toolbar. -->
        <action
            android:id="@+id/action_home_to_misOfertas"
            app:destination="@id/misOfertasFragment" />

    </fragment>

    <!--
        Detalle de publicación (Punto 4). Colgado de homeFragment: se llega
        tocando una tarjeta del Home, y desde acá se puede ir al perfil público
        del vendedor.
    -->
    <fragment
        android:id="@+id/detalleFragment"
        android:name="com.example.tpo.ui.detalle.DetalleFragment"
        android:label="@string/detalle_titulo"
        tools:layout="@layout/fragment_detalle">
        <argument
            android:name="publicacionId"
            app:argType="string" />

        <action
            android:id="@+id/action_detalle_to_perfil"
            app:destination="@id/perfilVendedorFragment" />
    </fragment>

    <!--
        Perfil público de cualquier usuario (Punto 2, "consultar el perfil público
        de la otra parte", y Punto 4, "acceso a su perfil público") — no confundir
        con perfilFragment (el perfil propio del bottom nav). Es una sola pantalla
        para los dos puntos: se llega desde el Detalle, desde el Historial (la
        contraparte), desde una calificación (su autor) y desde "Ver mi perfil
        público". El argumento se sigue llamando vendedorId por compatibilidad,
        pero puede ser el id de cualquier usuario. Detalle y Perfil se pueden
        encadenar (ver un perfil, entrar a otra publicación suya, ver ese
        perfil...), así que la pila puede crecer. Se deja crecer a propósito:
        el "atrás" devuelve al usuario exactamente por donde vino, que es lo
        que espera. NO poner popUpTo para "cortar el ciclo": eso saca de la
        pila una pantalla que el usuario sí vio y el "atrás" termina saltando
        a otro lado.
    -->
    <fragment
        android:id="@+id/perfilVendedorFragment"
        android:name="com.example.tpo.ui.perfil.PerfilVendedorFragment"
        android:label="@string/perfil_vendedor_titulo"
        tools:layout="@layout/fragment_perfil_vendedor">
        <argument
            android:name="vendedorId"
            app:argType="string" />

        <action
            android:id="@+id/action_perfil_to_detalle"
            app:destination="@id/detalleFragment" />

        <!-- Tocar el autor de una calificación abre su perfil público. -->
        <action
            android:id="@+id/action_perfilPublico_to_perfilPublico"
            app:destination="@id/perfilVendedorFragment" />
    </fragment>

    <!-- Favoritos: destino de la bottom nav, ver menu_navegacion.xml. -->
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.tpo.ui.favoritos.FavoritosFragment"
        android:label="@string/favoritos_titulo"
        tools:layout="@layout/fragment_favoritos">

        <action
            android:id="@+id/action_favoritos_to_detalle"
            app:destination="@id/detalleFragment" />

    </fragment>

    <!-- Punto 2 - Perfil y Reputación -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.tpo.ui.perfil.PerfilFragment"
        android:label="@string/perfil_titulo"
        tools:layout="@layout/fragment_perfil">

        <action
            android:id="@+id/action_miPerfil_to_perfilPublico"
            app:destination="@id/perfilVendedorFragment" />

        <action
            android:id="@+id/action_miPerfil_to_historial"
            app:destination="@id/historialFragment" />

    </fragment>

    <!--
        Punto 9 - Historial de operaciones y calificaciones. Se llega desde "Mis
        operaciones" en el perfil propio; la hoja para calificar
        (CalificarBottomSheet) se abre desde acá y no es un destino del grafo,
        igual que los bottom sheets del Home.
    -->
    <fragment
        android:id="@+id/historialFragment"
        android:name="com.example.tpo.ui.historial.HistorialFragment"
        android:label="@string/historial_titulo"
        tools:layout="@layout/fragment_historial">

        <!-- Tocar la contraparte de una operación abre su perfil público. -->
        <action
            android:id="@+id/action_historial_to_perfilPublico"
            app:destination="@id/perfilVendedorFragment" />

    </fragment>

    <!-- Punto 1 - Login. Primera pantalla de la app. -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tpo.login.LoginFragment"
        tools:layout="@layout/fragment_login">

        <!-- popUpTo + inclusive: al entrar al Home el login sale del historial,
             así el botón "atrás" cierra la app en vez de volver al login. -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <!-- Punto 5: wizard de publicación, ver nav_graph_publicar.xml. -->
    <include app:graph="@navigation/nav_graph_publicar" />

    <fragment
        android:id="@+id/misPublicacionesFragment"
        android:name="com.example.tpo.ui.mispublicaciones.MisPublicacionesFragment"
        android:label="@string/mis_publicaciones_titulo"
        tools:layout="@layout/fragment_mis_publicaciones" />

    <!-- Punto 7: "Mis ofertas", negociación de ofertas. -->
    <fragment
        android:id="@+id/misOfertasFragment"
        android:name="com.example.tpo.ui.misofertas.MisOfertasFragment"
        android:label="@string/mis_ofertas_titulo"
        tools:layout="@layout/fragment_mis_ofertas" />

</navigation>
